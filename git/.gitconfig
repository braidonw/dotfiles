# Identity, signing, and anything machine-specific lives in ~/.gitconfig.local,
# which is untracked and created per machine from git/.gitconfig.local.example.
# A missing include is silently ignored by git, so verify with:
#   git var GIT_AUTHOR_IDENT
[include]
	path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[branch]
	autoSetupMerge = simple
[push]
	autoSetupRemote = true
