# Secrets
gh/.config/gh/hosts.yml

# Auto-generated / machine-local state
fish/.config/fish/fish_variables
herdr/.config/herdr/.config.toml.gpui-lock

# Skills installed and updated by the Rex and Herdr apps
agents/.agents/skills/rex/
agents/.agents/skills/herdr-automations/
agents/.agents/skills/herdr-gpui-browser/
claude/.claude/skills/rex/
claude/.claude/skills/herdr-automations/
claude/.claude/skills/herdr-gpui-browser/

# Ignore everything under claude/.claude/ except what we deliberately track
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
!claude/.claude/statusline.sh
!claude/.claude/agents/
!claude/.claude/commands/
!claude/.claude/skills/
claude/.claude/skills/*-workspace/
claude/.claude/skills/synced/

# Ignore everything under agents/.agents/ except what we deliberately track
agents/.agents/*
!agents/.agents/AGENTS.md
!agents/.agents/bin/
!agents/.agents/writing/
!agents/.agents/skills/
agents/.agents/skills/*-workspace/

# Ignore everything under codex/.codex/ except what we deliberately track
codex/.codex/*
!codex/.codex/AGENTS.md
!codex/.codex/agents/
__pycache__/

# Zed local state
zed/.config/zed/settings_backup.json
zed/.config/zed/prompts/prompts-library-db.0.mdb/

# macOS
.DS_Store
