{
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "tiger-style": "off",
    "domain-modeling": "off",
    "prototype": "off",
    "tdd": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "linear@claude-plugins-official": false,
    "brooks-lint@brooks-lint-marketplace": false
  },
  "extraKnownMarketplaces": {
    "brooks-lint-marketplace": {
      "source": {
        "source": "github",
        "repo": "hyhmrright/brooks-lint"
      }
    }
  },
  "effortLevel": "high",
  "ultracode": false,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
